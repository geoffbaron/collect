# ── Supabase (required) ───────────────────────────────────────────────
# Project URL and the *publishable* (anon) key. Safe to expose to the browser —
# Row Level Security protects all data. Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://nrvlkoakvjlqvkqvncel.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ehxGkAGni7zVzhesCt4LDw_MVBGkpZD

# ── Supabase service role (required for /api/v1/* public API) ────────────
# The *secret* service-role key. Bypasses Row Level Security — never expose
# to the browser or commit a real value. Find it in Supabase → Project
# Settings → API → service_role. Required for the public REST API
# (web/src/app/api/v1/*), which authenticates via API key instead of a
# user session.
SUPABASE_SERVICE_ROLE_KEY=

# ── Download links (optional — shown on the marketing + /download pages) ──
# iOS app: TestFlight public link or App Store URL. Leave blank to show "coming soon".
NEXT_PUBLIC_IOS_APP_URL=
# Chrome Web Store URL for the extension. Leave blank to fall back to the
# self-hosted /downloads/collect-extension.zip bundled with this site.
NEXT_PUBLIC_EXTENSION_STORE_URL=
